{
  "schema_version": "pulsara.kernel-dogfood-scenario.v2",
  "scenario_id": "prompt-queue-fifo",
  "description": "Submit two durable prompts before delivery settles and prove canonical FIFO consumption into two completed turns.",
  "model_role": "flash",
  "timeout_seconds": 600,
  "system_prompt": "You are running Pulsara's prompt-queue FIFO dogfood. Perform each queued request exactly, use only write_file, and never inspect credentials or environment variables.",
  "fixture": {
    "fixture_kind": "directory_copy",
    "workdir": "workdir"
  },
  "workflow": {
    "workflow_kind": "prompt_queue_fifo",
    "prompts": [
      "Create queue_first.txt whose entire contents are QUEUE_FIRST_ACCEPTED_V2. Use write_file exactly once and do nothing else.",
      "Create queue_second.txt whose entire contents are QUEUE_SECOND_ACCEPTED_V2. Use write_file exactly once, do not modify queue_first.txt, and do nothing else."
    ],
    "completion_timeout_seconds": 300
  },
  "verifier": {
    "path": "verify.py",
    "timeout_seconds": 20
  },
  "evidence_gate": {
    "min_root_turns": 2,
    "max_root_turns": 2,
    "min_all_turns": 2,
    "max_all_turns": 2,
    "min_model_calls": 2,
    "max_model_calls": 6,
    "min_tool_calls": 2,
    "max_tool_calls": 4,
    "committed_event_minimums": [
      {"event_type": "PromptConsumed", "minimum": 2},
      {"event_type": "PromptQueued", "minimum": 2},
      {"event_type": "ToolResultAccepted", "minimum": 2},
      {"event_type": "TurnCompleted", "minimum": 2},
      {"event_type": "UserMessageAccepted", "minimum": 2}
    ],
    "forbidden_event_types": [
      "PromptCancelled",
      "PromptRejected",
      "TurnInterrupted"
    ],
    "root_turn_tool_gate": {
      "turn_selector": "all",
      "required_exact_counts": [
        {"tool_name": "write_file", "exact_count": 2}
      ],
      "forbidden_tool_names": ["read_file", "search_files", "terminal"]
    },
    "expected_prompt_queue_statuses": ["CONSUMED", "CONSUMED"],
    "expected_writer_generation_delta": 0
  }
}
