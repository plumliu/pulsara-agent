{
  "name": "pulsara-desktop",
  "productName": "Pulsara",
  "desktopName": "pulsara-desktop.desktop",
  "version": "0.1.0-alpha.2",
  "description": "Pulsara local agent workbench",
  "author": "Pulsara",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/*.test.js",
    "prepare:resources": "../.venv/bin/python scripts/prepare_resources.py",
    "package:dir": "node scripts/linux-hooks.cjs && npm run build && electron-builder --dir",
    "package": "node scripts/linux-hooks.cjs && npm run build && electron-builder",
    "test:browser": "npm run build && electron scripts/browser-owner-smoke.cjs",
    "test:startup": "npm run build && electron scripts/startup-cover-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "dev.pulsara.desktop",
    "productName": "Pulsara",
    "protocols": [
      {
        "name": "Pulsara",
        "schemes": [
          "pulsara"
        ]
      }
    ],
    "executableName": "pulsara",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "from": "scripts/pulsara-cli.sh",
        "to": "bin/pulsara"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/pulsara.icns",
      "minimumSystemVersion": "15.0.0",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Pulsara-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "deb"
      ],
      "icon": "assets/pulsara.icns",
      "category": "Utility",
      "desktop": {
        "entry": {
          "Name": "Pulsara",
          "Comment": "Local agent workbench"
        }
      },
      "executableName": "pulsara-desktop"
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh",
      "afterRemove": "build/linux-after-remove.sh",
      "recommends": [],
      "appArmorProfile": "build/linux-apparmor-profile",
      "maintainer": "Pulsara maintainers",
      "artifactName": "Pulsara-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/linux-cli-entry.cjs"
  },
  "homepage": "https://github.com/plumliu/pulsara-agent"
}
